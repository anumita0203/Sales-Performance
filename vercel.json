{
  "rootDirectory": "frontend/salesPerformance",
  "buildCommand": "npm run build:ssr",
  "outputDirectory": "dist/salesPerformance/browser",
  "functions": {
    "api/server.js": {
      "runtime": "@vercel/node"
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/server.js" }
  ]
}
